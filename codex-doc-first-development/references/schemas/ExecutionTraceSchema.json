{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutionTraceSchema",
  "type": "object",
  "required": [
    "tx_id",
    "iteration_index",
    "timestamp",
    "action_type",
    "normalized_path",
    "intent_hash",
    "result_status",
    "ignored_candidates"
  ],
  "properties": {
    "tx_id": {
      "type": "string"
    },
    "iteration_index": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string"
    },
    "action_type": {
      "type": "string",
      "enum": ["FILE_WRITE", "FILE_DELETE", "COMMAND_EXEC", "MODE_SWITCH"]
    },
    "normalized_path": {
      "type": "string"
    },
    "intent_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "result_status": {
      "type": "string",
      "enum": ["COMPLETED", "EXPANDED_RESUME", "FUSED_TO_PLAN", "CIRCUIT_BROKEN"]
    },
    "ignored_candidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_metadata": {
      "type": "object",
      "properties": {
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "mime_type": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
