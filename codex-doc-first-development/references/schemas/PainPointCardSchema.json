{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PainPointCardSchema",
  "type": "object",
  "required": [
    "card_id",
    "title",
    "category",
    "trigger_rules",
    "inspection_cmd",
    "version",
    "last_validated"
  ],
  "properties": {
    "card_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "CONCURRENCY_RACE",
        "STATE_MEMORY_LEAK",
        "SCHEMA_MIGRATION",
        "CROSS_PLATFORM",
        "PERFORMANCE_DEGRADATION",
        "SECURITY_PERMISSION"
      ]
    },
    "trigger_rules": {
      "type": "object",
      "required": ["mandatory_keywords", "pattern_contexts"],
      "properties": {
        "mandatory_keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "pattern_contexts": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "inspection_cmd": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "last_validated": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
